# --- MIME types (PWA correctness) ---
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
  AddType image/svg+xml .svg
</IfModule>

# --- SPA fallback ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /kortfolio/

  # Route /kortfolio/api/contact to PHP handler
  RewriteRule ^api/contact/?$ api/contact.php [L,QSA]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# --- Headers ---
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Content-hashed build assets are safe to cache immutably. (sw.js is matched
  # here too, but the more specific rule below is last, so it wins for sw.js.)
  <FilesMatch "\.(js|css|woff2?|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The service worker must never be cached, so updates are picked up promptly.
  # NOTE: Hostinger's hcdn currently overrides this at the edge (served
  # `max-age=604800`); the effective fix must be applied in the host/edge config.
  <FilesMatch "sw\.js$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
  </FilesMatch>
</IfModule>
